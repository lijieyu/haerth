{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haerth",
  // Set this to today's date
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "haerth.org",
      "custom_domain": true
    },
    {
      "pattern": "www.haerth.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
